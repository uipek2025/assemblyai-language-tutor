# Required
ASSEMBLYAI_API_KEY=

# global (nearest region) | us | eu  — "eu" keeps STT, LLM and TTS traffic in the EU
ASSEMBLYAI_REGION=global

# Realtime STT model for the tutor (turn-taking) and for the pitch page (captions)
ASSEMBLYAI_SPEECH_MODEL=assemblyai-stt-3-7-realtime-agent
ASSEMBLYAI_CAPTION_MODEL=assemblyai-stt-3-7-realtime

# LLM Gateway chain, tried in order (list: https://llm-gateway.assemblyai.com/v1/models).
# Most Gateway models need a paid account. Free keys can call gemma-4-31b and
# qwen3.5-4b-32k-fast; the server finds the first usable model at startup and logs it.
LLM_MODEL=gemini-2.5-flash-lite
LLM_FALLBACK_MODELS=qwen3-32B,gemma-4-31b,qwen3.5-4b-32k-fast
# Spend a few tokens at startup finding that model (0 to turn off)
LLM_STARTUP_PROBE=1

# One TTS-1 voice for every language keeps the tutor sounding like one person.
# Leave empty to use each language's default voice.
TTS_VOICE_ID=aai-kyla

# Practice-feedback threshold: matched words below this STT confidence are "unclear"
GRADING_LOW_CONFIDENCE=0.5
